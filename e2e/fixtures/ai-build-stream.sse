f4f-8e7f-e7dc34f62e92","name":"Fang of the Pack","scryfallId":"27bcf935-6e35-41bc-b1eb-6ec92b1647d5","manaCost":"{5}{G}","typeLine":"Creature \u2014 Wolf","imageUriArtCrop":"https://cards.scryfall.io/art_crop/front/2/7/27bcf935-6e35-41bc-b1eb-6ec92b1647d5.jpg?1783937344","board":"main","quantity":1},{"oracleId":"2f8872fe-84dc-4cda-a253-e7503a5c96a3","name":"Wolfbriar Elemental","scryfallId":"60da801e-c47c-4aac-928c-2e7eab2d24c6","manaCost":"{2}{G}{G}","typeLine":"Creature \u2014 Elemental","imageUriArtCrop":"https://cards.scryfall.io/art_crop/front/6/0/60da801e-c47c-4aac-928c-2e7eab2d24c6.jpg?1783936238","board":"main","quantity":1},{"oracleId":"dccf9497-cc7b-42df-9b46-f5ffea0c7474","name":"Wolfir Silverheart","scryfallId":"97ea9f5f-33f0-4d30-9bd2-608f9f2ffa0a","manaCost":"{3}{G}{G}","typeLine":"Creature \u2014 Wolf Warrior","imageUriArtCrop":"https://cards.scryfall.io/art_crop/front/8/6/8629c598-11c8-4911-acfb-0643e5feffa8.jpg?1783940656","board":"main","quantity":1},{"oracleId":"3509171e-8d7d-4e9e-97a1-58e6c7d225ed","name":"Summon: Fenrir","scryfallId":"412093fb-15c1-4b36-aa53-9484f955ee2c","manaCost":"{2}{G}","typeLine":"Creature Enchantment \u2014 Saga Wolf","imageUriArtCrop":"https://cards.scryfall.io/art_crop/front/9/3/93feb9d5-d004-4598-a448-b3488c869c05.jpg?1783906581","board":"main","quantity":1},{"oracleId":"614c3f71-e231-4c12-9e6b-cb8ea1d100bf","name":"Howlpack Resurgence","scryfallId":"c0dc4c08-ed18-454b-b061-8901c253005c","manaCost":"{2}{G}","typeLine":"Enchantment","imageUriArtCrop":"https://cards.scryfall.io/art_crop/front/c/0/c0dc4c08-ed18-454b-b061-8901c253005c.jpg?1783908097","board":"main","quantity":1},{"oracleId":"868b758c-e21c-4079-a1fc-4c89af106f4b","name":"Howl of the Night Pack","scryfallId":"f7f60ebd-4f6b-4562-8dec-d4b4e124cb73","manaCost":"{6}{G}","typeLine":"Sorcery","imageUriArtCrop":"https://cards.scryfall.io/art_crop/front/2/0/20fc5ff1-b8bd-44d5-a659-17eeae06736a.jpg?1783939903","board":"main","quantity":1}],"mainTarget":99,"mainShortfall":0,"cardsSkipped":0,"skippedByReason":{},"assessment":{"verdict":"This is a Golgari Wolf tribal deck that genuinely feeds all three of the commander\u0027s lines: 31 creatures with a deep Wolf-token core (Howl of the Night Pack, Wolfbriar Elemental, Master of the Wild Hunt, Wren\u0027s Run Packmaster, Wolf-Skull Shaman, Turntimber Ranger) means the \u0022another Wolf enters\u0022 counter trigger fires many times per game, and menace plus that pile of counters makes commander damage a real clock. The mana is fine for a 3.02 curve once the five ramp pieces filed under \u0022other\u0022 are counted, and the interaction split \u2014 nine pieces of spot and catch-all removal with zero symmetrical wipes \u2014 is exactly right for a board this creature-dense. The single biggest lever is the third ability: the trigger-doubling clause only reaches Wolves, and most of the deck\u0027s best triggered abilities sit on non-Wolf bodies, so adding Wolves that carry their own triggers converts dead text into the deck\u0027s strongest engine.","findings":[{"area":"Plan","severity":"note","finding":"The counter half of the commander is well fed: six-plus cards that make Wolf tokens (Howl of the Night Pack, Wolfbriar Elemental, Master of the Wild Hunt, Wren\u0027s Run Packmaster, Wolf-Skull Shaman, Turntimber Ranger) each put multiple Wolves onto the battlefield, and every one of those tokens is a separate \u0027another Wolf you control enters\u0027 trigger.","fix":""},{"area":"Plan","severity":"improve","finding":"The trigger-doubling clause is restricted to \u0027another Wolf or battle you control\u0027 (\u00A79.10), and several of the deck\u0027s most trigger-heavy cards are not Wolves by type \u2014 Master of the Wild Hunt, Wren\u0027s Run Packmaster, Wolf-Skull Shaman, Wolfbriar Elemental and Wolfir Silverheart are not Wolf creatures, so their abilities are never doubled. The clause currently only reaches a handful of Wolf-typed permanents such as Nightpack Ambusher, Silverfur Partisan and Sarulf\u0027s Packmate.","fix":"Swap two or three non-Wolf bodies for Wolf-typed creatures whose value comes from a triggered ability (ETB, attack, or end-step triggers), so the doubling clause has more targets."},{"area":"Plan","severity":"note","finding":"The deck contains zero battles, so half of the doubling clause (\u0027or battle you control\u0027) is dead text as built.","fix":""},{"area":"Plan","severity":"note","finding":"Tribal payoffs and lands assume Wolf typing, but Cavern of Souls and Secluded Courtyard naming Wolf will not cast Wolfbriar Elemental, Master of the Wild Hunt, Wren\u0027s Run Packmaster or Wolf-Skull Shaman, and Howlpack Resurgence\u0027s anthem likewise reads on Wolves rather than on those bodies.","fix":"Accept the split, or lean the creature base further toward genuine Wolf types so the tribal lands and anthem cover more of the board."},{"area":"Mana","severity":"note","finding":"The role table shows 8 ramp / 44 sources, but Arcane Signet, Three Visits, Nature\u0027s Lore, Wolfwillow Haven and Birds of Paradise sit in the \u0027other\u0027 bucket \u2014 real ramp is roughly 13 and real mana sources roughly 49, comfortably above the 45\u201348 band of \u00A72.1 for a 3.02 average mana value.","fix":""},{"area":"Mana","severity":"improve","finding":"Green is the demanding colour \u2014 Nightpack Ambusher, Wolfbriar Elemental, Master of the Wild Hunt and Wolfir Silverheart all want double green early \u2014 and 20 green lands sits under the 27\u201329 sources \u00A73.2 wants for {G}{G} on turn 3; Birds of Paradise, Llanowar Elves, Wolfwillow Haven, Golgari Signet, Talisman of Resilience and Arcane Signet close most but not all of that gap.","fix":"Trade one or two of the colourless-leaning utility lands (Takenuma, Three Tree City) for a basic Forest or another untapped green dual."},{"area":"Mana","severity":"note","finding":"Black at 17 lands plus the three rocks is adequate because black is used almost entirely for single-pip removal (Go for the Throat, Infernal Grasp, Feed the Swarm), which \u00A73.2 puts at 19\u201320 sources by turn 3\u20134.","fix":""},{"area":"Interaction","severity":"note","finding":"Nine pieces with no symmetrical mass removal is correct for a 49%-creature, token-producing board (\u00A76.4), and the split covers the Golgari gaps well: Assassin\u0027s Trophy and Beast Within answer any permanent, Putrefy, Abrupt Decay, Tear Asunder and Feed the Swarm handle artifacts and enchantments, and Bojuka Bog supplies graveyard hate.","fix":""},{"area":"Interaction","severity":"improve","finding":"Golgari has no counterspells (\u00A76.3), so a resolved opposing wipe or a hard lock is answered only after the fact, and the deck\u0027s nine answers are almost all one-for-one sorcery- or instant-speed spot removal with no repeatable outlet.","fix":"Add one repeatable removal engine or a reusable sacrifice-style answer so the deck is not purely one-for-one against a rebuilt board."},{"area":"Resilience","severity":"note","finding":"Four protection pieces \u2014 Heroic Intervention, Snakeskin Veil, Swiftfoot Boots, Lightning Greaves \u2014 matches the 2\u20134 band for a commander this central, and Greaves/Boots also let the counter-loaded Chief attack the turn it lands.","fix":""},{"area":"Resilience","severity":"improve","finding":"Recursion is close to nonexistent: Takenuma, Abandoned Mire is essentially the only rebuy in 99 cards, and the deck\u0027s card advantage (Beast Whisperer, Guardian Project, Elemental Bond, Garruk\u0027s Uprising, Tribute to the World Tree, Toski) is entirely creature-dependent, so a single opposing sweeper turns off the draw engine and the board at once.","fix":"Add one or two recursion effects that return creatures from the graveyard, trimming one of the six overlapping creature-ETB draw enchantments."}],"facts":{"cards":99,"lands":36,"ramp":8,"draw":10,"interaction":9,"other":36,"creatures":31,"creaturePercentOfNonland":49,"manaSources":44,"averageManaValue":3.02,"colorSources":[{"color":"B","count":17},{"color":"G","count":20}]}}}

