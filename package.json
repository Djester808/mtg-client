{
  "name": "mtg-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "verify": "npm run format:check && ng lint && node tools/check-dead-styles.js && node tools/check-shared-treatments.js && node tools/check-ui-states.js && ng test --watch=false --browsers=ChromeHeadless --code-coverage && node tools/check-new-coverage.js && ng build --configuration production",
    "verify:ui": "cd e2e && node shoot.js --dpr=1 && node shoot-states.js && node shoot-states.js --devices=desktop --only=board,commander-charts,settings-accessibility,deck-type-pie,profile-format-menu && node verify-same.js && node sheet.js && cd .. && node tools/check-ui-audit.js && npm run verify:brand && npm run verify:parity-port && npm run verify:collection-scale && npm run verify:explore-port && npm run verify:draft-port",
    "verify:ui:update": "node tools/check-ui-audit.js --update",
    "verify:brand": "node e2e/verify-brand.js",
    "verify:responsive": "node e2e/verify-responsive.js",
    "verify:parity-port": "node e2e/verify-parity-port.js",
    "verify:explore-port": "node e2e/verify-explore-port.js",
    "verify:collection-scale": "node e2e/verify-collection-scale.js",
    "verify:draft-port": "node e2e/verify-draft-port.js"
  },
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@microsoft/signalr": "^10.0.11",
    "@ngrx/effects": "^17.2.0",
    "@ngrx/entity": "^17.2.0",
    "@ngrx/store": "^17.2.0",
    "@ngrx/store-devtools": "^17.2.0",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.1",
    "mana-font": "^1.18.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.2",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.0",
    "@angular-eslint/builder": "^17.5.3",
    "@angular-eslint/eslint-plugin": "^17.5.3",
    "@angular-eslint/eslint-plugin-template": "^17.5.3",
    "@angular-eslint/schematics": "^17.5.3",
    "@angular-eslint/template-parser": "^17.5.3",
    "@angular/cli": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jasmine-core": "^6.2.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "postcss": "^8.5.12",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.4.2"
  }
}
